# Neon Postgres (Vercel Marketplace > Neon). Pooled bağlantı dizesi.
DATABASE_URL=

# Better Auth
# Üretmek için: npx @better-auth/cli secret   (en az 32 karakter)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_BETTER_AUTH_URL=http://localhost:3000

# iyzico (sandbox panelinden: sandbox-merchant.iyzipay.com > Ayarlar > API anahtarları)
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_MERCHANT_ID=
# Sandbox varsayılan. Canlıda: https://api.iyzipay.com
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Vercel Blob (özel dosyalar: taahhütname, logo, fotoğraflar). Yoksa yalnızca geliştirmede .uploads/ kullanılır.
BLOB_READ_WRITE_TOKEN=

# Resend (işlem e-postaları). Anahtar ya da EMAIL_FROM yoksa e-posta gönderilmez, konu sunucu loguna yazılır.
RESEND_API_KEY=
# Doğrulanmış alan adından, örnek: Kaşif Yazılım <bilgi@kasifyazilim.com>
EMAIL_FROM=
# Yönetici bildirimlerinin (yeni talep, iptal talebi, iletişim formu) gideceği adres
ADMIN_EMAIL=

# Vercel Cron için gizli anahtar (Vercel isteğe Authorization: Bearer ekler). Üretmek için: openssl rand -hex 32
CRON_SECRET=
