# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
!.env.example

# Yerel geliştirme dosya depolaması (BLOB_READ_WRITE_TOKEN yokken)
/.uploads

# Ekran görüntüleri (geliştirme sırasında alınanlar, 11 MB)
/docs/ekran/

# Üçüncü taraf ajan skill dosyaları ve yerel ajan ayarları (skills-lock.json ile yeniden kurulabilir)
/.claude/
